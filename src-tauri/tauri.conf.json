{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeoChat",
  "version": "0.6.1",
  "identifier": "ai.geochat.desktop",
  "build": {
    "beforeDevCommand": "bun run tauri:renderer:dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "bun run tauri:prepare",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "GeoChat",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' geochat-bundle:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; script-src 'self' geochat-bundle: 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' geochat-bundle: 'unsafe-inline'; img-src 'self' geochat-bundle: https://assets.chat-with-geogebra.com data: blob:; font-src 'self' geochat-bundle: data:; worker-src 'self' geochat-bundle: blob:; child-src 'self' geochat-bundle: blob:; manifest-src 'self' geochat-bundle:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../dist/backend",
      "../dist/runtime",
      "../dist/renderer",
      "../dist/vendor",
      "../dist/benchmarks",
      "../dist/app-bundle-manifest.json"
    ]
  }
}
