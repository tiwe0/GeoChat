{
  "name": "geochat-desktop",
  "version": "0.5.7",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "GeoChat Desktop open-source client built with a Tauri 2 shell, SolidJS UI, and a backend bundle on a Bun runtime sidecar.",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "bun run tauri:prepare",
    "build": "bun run typecheck && bun run tauri:prepare",
    "build:backend": "bun scripts/build-backend-bundle.mjs",
    "stage:runtime": "bun scripts/stage-runtime-sidecar.mjs",
    "stage:vendor": "bun scripts/stage-vendor-bundle.mjs",
    "bundle:smoke": "bun scripts/smoke-app-bundle-manifest.mjs",
    "bundle:install": "bun scripts/install-app-bundle.mjs",
    "package:backend-smoke": "bun scripts/smoke-packaged-backend-runtime.mjs",
    "preview": "vite preview --config vite.react.config.ts --host 127.0.0.1",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:dev:mcp": "tauri dev --config src-tauri/tauri.dev.conf.json -- -- --mcp",
    "tauri:prepare": "bun run build:backend && bun run tauri:renderer:build && bun scripts/stage-vendor-bundle.mjs && bun scripts/stage-runtime-sidecar.mjs && bun run stage:benchmarks && bun scripts/write-app-bundle-manifest.mjs",
    "tauri:build": "tauri build --bundles app",
    "tauri:build:macos": "tauri build --bundles app,dmg",
    "tauri:build:windows": "tauri build --bundles nsis",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri:local:acceptance": "bun scripts/run-tauri-local-acceptance.mjs",
    "tauri:package:smoke": "bun scripts/smoke-tauri-packaged-layout.mjs",
    "tauri:renderer:dev": "vite --config vite.react.config.ts",
    "tauri:renderer:build": "vite build --config vite.react.config.ts && bun run renderer:chunks:check",
    "renderer:chunks:check": "bun scripts/check-renderer-chunks.mjs",
    "release": "node scripts/release.mjs",
    "dist": "bun run tauri:build",
    "test": "bun test tests",
    "typecheck": "tsc -p packages/app/tsconfig.json --pretty && tsc -p tsconfig.node.json --pretty && tsc -p tsconfig.web.json --pretty",
    "backend:dev": "bun --watch backend/src/index.ts",
    "backend:start": "bun backend/src/index.ts",
    "datasets:download-hf": "bun tools/download-huggingface-problem-datasets.ts",
    "datasets:profile-hf": "bun tools/profile-huggingface-problem-datasets.ts",
    "datasets:import-hf-unified": "bun tools/import-huggingface-unified-problems.ts",
    "datasets:import-gaokao-cases": "bun tools/import-gaokao-problem-cases-to-unified.ts",
    "geogebra:commands:generate": "bun scripts/generate-geogebra-command-reference.mjs",
    "geogebra:commands:check": "bun scripts/generate-geogebra-command-reference.mjs --check",
    "mcp:desktop-debug": "bun tools/desktop-debug-mcp/index.ts",
    "mcp:desktop-debug:http": "bun tools/desktop-debug-mcp/http.ts",
    "mcp:desktop-debug:smoke": "bun tools/desktop-debug-mcp/smoke.ts",
    "eval:harness": "mkdir -p .artifacts && bun test tests/agent-harness-evals.test.ts tests/p0-agent-hardening.test.ts --reporter=junit --reporter-outfile=.artifacts/agent-harness-evals.xml",
    "benchmark:validate": "bun tools/validate-benchmark-suite.ts",
    "benchmark:test": "bun test tests/benchmark-contract.test.ts tests/benchmark-evaluator.test.ts tests/benchmark-backend.test.ts tests/benchmark-runner.test.ts",
    "benchmark:run": "bun tools/run-benchmark-suite.ts",
    "stage:benchmarks": "bun scripts/stage-benchmark-suite.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@ai-sdk/alibaba": "^2.0.41",
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/deepseek": "3.0.50",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/react": "4.0.112",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@geochat-ai/app": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/math": "^1.0.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/bun": "^1.3.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "ai": "7.0.109",
    "canvas-confetti": "^1.9.4",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.2",
    "i18next": "^26.4.2",
    "katex": "^0.18.7",
    "motion": "^13.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.13",
    "react-joyride": "^3.2.0",
    "shiki": "3.23.0",
    "streamdown": "^2.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "zod": "^4.1.13"
  }
}
